"""Diabetes Prediction pipeline converted from Diabetes_Prediction.ipynb.

Required packages:
    pip install pandas numpy matplotlib seaborn scikit-learn xgboost joblib
"""

import joblib
import matplotlib.pyplot as plt
import numpy as np
import pandas as pd
import seaborn as sns
from sklearn import metrics
from sklearn.ensemble import GradientBoostingClassifier, RandomForestClassifier
from sklearn.linear_model import LogisticRegression
from sklearn.metrics import ConfusionMatrixDisplay
from sklearn.model_selection import train_test_split
from xgboost import XGBClassifier


def main() -> None:
    # 1. Load dataset
    df = pd.read_csv("Diabetes_Prediction_Dataset.csv")
    df.index = range(1, len(df) + 1)
    print(df)

    # 2. Exploratory data analysis
    df.info()
    print(df.describe().round(2))
    print("Shape:", df.shape)
    print("Missing values:\n", df.isnull().sum())
    print("Duplicated rows:", df.duplicated().sum())
    print("Unique Patient IDs:", df["Patient_ID"].nunique())
    print("Total records:", len(df))
    print("Duplicate Patient IDs:", df["Patient_ID"].duplicated().sum())
    print("Diabetes value counts:\n", df["Diabetes"].value_counts())

    plt.figure(figsize=(6, 4))
    sns.countplot(data=df, x="Diabetes", color="steelblue")
    plt.title("Diabetes Class Distribution")
    plt.xlabel("Diabetes")
    plt.ylabel("Number of Patients")
    plt.tight_layout()
    plt.show()

    numeric_columns = [
        "Age",
        "BMI",
        "Glucose",
        "Blood_Pressure",
        "Cholesterol",
        "Insulin",
        "HbA1c",
    ]

    plt.figure(figsize=(14, 8))
    for i, column in enumerate(numeric_columns, 1):
        plt.subplot(3, 3, i)
        sns.boxplot(x=df[column], color="steelblue")
    plt.tight_layout()
    plt.show()

    # 3. Data cleaning & outlier removal
    print(df["Blood_Pressure"].describe().round(2))
    df = df[df["Blood_Pressure"] != 999]
    print("Shape after removing Blood_Pressure == 999:", df.shape)

    # 4. Encode categorical features
    df["Gender"] = df["Gender"].map({"Female": 0, "Male": 1, "Unknown": 2})
    df["Smoking_Status"] = df["Smoking_Status"].map(
        {"Never": 0, "Former": 1, "Current": 2}
    )
    df["Physical_Activity"] = df["Physical_Activity"].map(
        {"Low": 0, "Moderate": 1, "High": 2}
    )
    df["Family_History"] = df["Family_History"].map({"No": 0, "Yes": 1})
    df["Diabetes"] = df["Diabetes"].map({"No": 0, "Yes": 1})

    print(df.head())

    # 5. Impute missing values
    print("Missing values before imputation:\n", df.isnull().sum())
    df["BMI"] = df["BMI"].fillna(df["BMI"].median())
    df["Glucose"] = df["Glucose"].fillna(df["Glucose"].median())
    print("Missing values after imputation:\n", df.isnull().sum())

    # 6. Feature / target split and train-test split
    X = df.drop(["Patient_ID", "Diabetes"], axis=1)
    y = df["Diabetes"]

    X_train, X_test, y_train, y_test = train_test_split(
        X, y, test_size=0.20, random_state=42, stratify=y
    )

    # 7. Train models
    lr = LogisticRegression(max_iter=1000)
    lr.fit(X_train, y_train)

    rf = RandomForestClassifier()
    rf.fit(X_train, y_train)

    gb = GradientBoostingClassifier()
    gb.fit(X_train, y_train)

    xg = XGBClassifier()
    xg.fit(X_train, y_train)

    # 8. Evaluate models
    y_pred1 = lr.predict(X_test)
    y_pred2 = rf.predict(X_test)
    y_pred3 = gb.predict(X_test)
    y_pred4 = xg.predict(X_test)

    final_data = pd.DataFrame(
        {
            "Models": ["LR", "RF", "GB", "XG"],
            "Accuracy": [
                metrics.accuracy_score(y_test, y_pred1),
                metrics.accuracy_score(y_test, y_pred2),
                metrics.accuracy_score(y_test, y_pred3),
                metrics.accuracy_score(y_test, y_pred4),
            ],
            "Precision": [
                metrics.precision_score(y_test, y_pred1),
                metrics.precision_score(y_test, y_pred2),
                metrics.precision_score(y_test, y_pred3),
                metrics.precision_score(y_test, y_pred4),
            ],
            "Recall": [
                metrics.recall_score(y_test, y_pred1),
                metrics.recall_score(y_test, y_pred2),
                metrics.recall_score(y_test, y_pred3),
                metrics.recall_score(y_test, y_pred4),
            ],
            "F1_SCORE": [
                metrics.f1_score(y_test, y_pred1),
                metrics.f1_score(y_test, y_pred2),
                metrics.f1_score(y_test, y_pred3),
                metrics.f1_score(y_test, y_pred4),
            ],
        }
    )
    final_data.index = range(1, len(final_data) + 1)
    print("\nModel Comparison:\n", final_data)

    # 9. Visualize model performance
    final_data_melted = final_data.melt(
        id_vars="Models",
        value_vars=["Accuracy", "F1_SCORE"],
        var_name="Metrics",
        value_name="Score",
    )
    plt.figure(figsize=(6.4, 4.8))
    sns.barplot(x="Models", y="Score", hue="Metrics", data=final_data_melted)
    plt.title("Accuracy vs F1 Score Comparison")
    plt.xlabel("Models")
    plt.ylabel("Score")
    plt.legend(title="Metrics", bbox_to_anchor=(1, 0.5))
    plt.tight_layout()
    plt.show()

    fig, axes = plt.subplots(2, 2, figsize=(12, 9))
    models = [
        ("Logistic Regression", y_pred1),
        ("Random Forest", y_pred2),
        ("Gradient Boosting", y_pred3),
        ("XGBoost", y_pred4),
    ]
    for ax, (name, prediction) in zip(axes.flatten(), models):
        ConfusionMatrixDisplay.from_predictions(
            y_test,
            prediction,
            display_labels=["No Diabetes", "Diabetes"],
            cmap="Blues",
            ax=ax,
            colorbar=False,
            values_format="d",
        )
        ax.set_title(name)
    plt.suptitle("Confusion Matrix Comparison of Four Models")
    plt.tight_layout()
    plt.show()

    # 10. Train final model on full dataset, save, reload, and predict
    gb_final = GradientBoostingClassifier()
    gb_final.fit(X, y)

    joblib.dump(gb_final, "diabetes_model.pkl")
    model = joblib.load("diabetes_model.pkl")

    data_new = pd.DataFrame(
        {
            "Age": [45],
            "Gender": [0],
            "BMI": [28.5],
            "Glucose": [120.0],
            "Blood_Pressure": [125],
            "Cholesterol": [210],
            "Insulin": [110],
            "HbA1c": [6.0],
            "Smoking_Status": [0],
            "Physical_Activity": [1],
            "Family_History": [0],
        },
        columns=X.columns,
    )
    print("\nSample input:\n", data_new)
    print("Sample prediction:", model.predict(data_new))


if __name__ == "__main__":
    main()
